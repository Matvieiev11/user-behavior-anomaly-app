/* GLOBAL */

QMainWindow {
    background-color: #f8fafc;
}

QWidget {
    color: #0f172a;
    font-family: Segoe UI;
    font-size: 13px;
}

QLabel {
    background-color: transparent;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget {
    background-color: #f8fafc;
}

QScrollArea > QWidget > QWidget {
    background-color: #f8fafc;
}

/* SCROLLBARS */

QScrollBar:vertical {
    background: #f1f5f9;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar:horizontal {
    background: #f1f5f9;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

/* SIDEBAR */

#sidebar {
    background-color: #ffffff;
    border-right: 1px solid #e2e8f0;
}

#menuTitle {
    color: #64748b;
    font-size: 11px;
    letter-spacing: 1px;
    font-weight: bold;
}

QPushButton#sideButton {
    background-color: transparent;
    color: #475569;
    border-radius: 10px;
    padding: 10px;
    text-align: left;
}

QPushButton#sideButton:hover {
    background-color: #e0f2fe;
    color: #0f172a;
}

QPushButton#sideButton[active="true"] {
    background-color: #2563eb;
    color: white;
    font-weight: 600;
}

QPushButton#sideButtonDanger {
    background-color: transparent;
    color: #dc2626;
    border: 1px solid #fecaca;
    border-radius: 8px;
    padding: 8px;
}

QPushButton#sideButtonDanger:hover {
    background-color: #dc2626;
    color: white;
}

/* LANGUAGE SWITCHER*/

#languageFrame {
    background-color: transparent;
    border: none;
}

#languageTitle {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

#languageButtonsFrame {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
}

QPushButton#langButton {
    background-color: transparent;
    color: #475569;
    border: none;
    border-radius: 10px;
    padding: 7px 8px;
    font-size: 11px;
    font-weight: 700;
    min-height: 26px;
}

QPushButton#langButton:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}

QPushButton#langButton:checked {
    background-color: #2563eb;
    color: white;
}

/* THEME SWITCHER */

#themeFrame {
    background-color: transparent;
    border: none;
}

#themeTitle {
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

#themeButtonsFrame {
    background-color: #f1f5f9;
    border: 1px solid #cbd5e1;
    border-radius: 14px;
}

QPushButton#themeButton {
    background-color: transparent;
    color: #334155;
    border: none;
    border-radius: 10px;
    padding: 7px 12px;
    font-size: 11px;
    font-weight: 700;
    min-height: 26px;
    min-width: 80px;
}

QPushButton#themeButton:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}

/* TITLES / TEXT */

#mainTitle {
    font-size: 28px;
    font-weight: bold;
    color: #0f172a;
}

#subTitle {
    font-size: 13px;
    color: #64748b;
}

#sectionTitle {
    font-size: 16px;
    font-weight: bold;
    color: #0f172a;
}

#infoLabel,
#statusLabel,
#filterLabel,
#statsLabel {
    color: #334155;
}

#statsLabel {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 12px;
}

#insightsText {
    color: #1e293b;
    font-size: 14px;
    background-color: transparent;
}

#gaugeSubLabel {
    color: #64748b;
    font-size: 12px;
}

/* FRAMES / CARDS */

#sectionFrame {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
}

#statCard {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    min-height: 110px;
}

#cardTitle {
    color: #64748b;
    font-size: 12px;
}

#cardValue {
    color: #0f172a;
    font-size: 28px;
    font-weight: bold;
}

/* BUTTONS */

#primaryButton {
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 18px;
    font-weight: bold;
}

#primaryButton:hover {
    background-color: #1d4ed8;
}

#accentButton {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 14px;
    color: #0f172a;
    font-weight: 600;
}

#accentButton:hover {
    background-color: #f1f5f9;
}

#secondaryButton {
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 14px;
    color: #334155;
}

#secondaryButton:hover {
    background-color: #e2e8f0;
}

/* COMBOBOX */

QComboBox#darkCombo {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 8px 12px;
    min-width: 220px;
    color: #0f172a;
}

QComboBox#darkCombo::drop-down {
    border: none;
}

QComboBox#darkCombo QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    selection-background-color: #2563eb;
    selection-color: white;
}

/* TABLES */

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    gridline-color: #e2e8f0;
    color: #0f172a;
    selection-background-color: #2563eb;
    selection-color: white;
}

QTableWidget::item {
    padding: 6px;
}

QTableWidget QTableCornerButton::section {
    background-color: #f1f5f9;
    border: none;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #0f172a;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #cbd5e1;
    font-weight: bold;
}

/* DASHBOARD */

QScrollArea#dashboardScrollArea {
    border: none;
    background: transparent;
}

QScrollArea#dashboardScrollArea > QWidget > QWidget {
    background: transparent;
}

/* AUTH WINDOW */

QWidget#authWindow {
    background-color: #f8fafc;
}

QLineEdit#authInput {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 14px;
}

QLineEdit#authInput:focus {
    border: 1px solid #2563eb;
}

QLineEdit#authInput::placeholder {
    color: #64748b;
}

/* MESSAGE BOXES */

QMessageBox#exitMessageBox,
QMessageBox#authMessageBox {
    background-color: #ffffff;
    color: #0f172a;
}

QMessageBox#exitMessageBox QLabel,
QMessageBox#authMessageBox QLabel {
    color: #0f172a;
    font-size: 14px;
    background: transparent;
}

QMessageBox#exitMessageBox QPushButton,
QMessageBox#authMessageBox QPushButton {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 8px 16px;
    min-width: 80px;
}

QMessageBox#exitMessageBox QPushButton:hover,
QMessageBox#authMessageBox QPushButton:hover {
    background-color: #2563eb;
    color: white;
}

QMessageBox#authMessageBox QPushButton:pressed {
    background-color: #1d4ed8;
}

/* MATPLOTLIB TOOLBAR */

#plotToolbar {
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 4px;
}

#plotToolbar QToolButton {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    padding: 4px;
    margin: 2px;
}

#plotToolbar QToolButton:hover {
    background-color: #2563eb;
    color: white;
}

#plotToolbar QToolButton:checked {
    background-color: #2563eb;
    color: white;
}